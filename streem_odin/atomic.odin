package streem

import "base:intrinsics"

// =============================================================================
// アトミック操作モジュール (Atomic Operations Module)
// =============================================================================
//
// 参照元: src/atomic.h
//
// このモジュールは、マルチスレッド環境で安全にデータを操作するための
// アトミック（不可分）操作を提供します。
//
// アトミック操作とは、他のスレッドから中断されることなく完了する操作のことです。
// これにより、複数のスレッドが同じメモリ位置にアクセスする際の
// データ競合（race condition）を防ぐことができます。
//
// C言語版では、GCCのビルトインアトミック関数が使用されています:
//   - __sync_bool_compare_and_swap  (比較して交換)
//   - __sync_fetch_and_add          (加算)
//   - __sync_fetch_and_sub          (減算)
//   - __sync_fetch_and_or           (論理OR)
//   - __sync_fetch_and_and          (論理AND)
//
// Odin言語では、base:intrinsicsパッケージがアトミック操作を提供しています。
// これらは直接CPUのアトミック命令にコンパイルされます。
//
// 注意: すべてのプロシージャは "contextless" として定義されています。
// これは、これらの関数がコンテキスト（アロケータなど）に依存せず、
// 割り込みハンドラや低レベルなコードからも安全に呼び出せることを意味します。
// =============================================================================

// -----------------------------------------------------------------------------
// atomic_cas (Compare-And-Swap / 比較交換)
// -----------------------------------------------------------------------------
// アトミックな比較交換操作を行います。
//
// 動作:
//   1. メモリ位置 *a の現在の値を old_val と比較
//   2. 等しければ、*a を new_val に更新
//   3. 等しくなければ、何もしない
//   この一連の操作はアトミックに（中断されることなく）実行されます。
//
// パラメータ:
//   a       - 操作対象のメモリ位置へのポインタ
//   old_val - 期待される現在の値
//   new_val - 交換後の新しい値
//
// 戻り値:
//   true  - 交換が成功した（*a が old_val と等しかった）
//   false - 交換が失敗した（*a が old_val と異なっていた）
//
// 使用例:
//   ロックフリーのデータ構造（スタック、キューなど）の実装で、
//   他のスレッドが値を変更していないことを確認しながら更新する際に使用します。
//
//   counter: int = 0
//   // カウンターが0の場合のみ1に設定
//   if atomic_cas(&counter, 0, 1) {
//       // 成功: counterは0から1に変更された
//   } else {
//       // 失敗: counterは既に0ではなかった
//   }
// -----------------------------------------------------------------------------
atomic_cas :: proc "contextless" (a: ^$T, old_val: T, new_val: T) -> bool {
	_, ok := intrinsics.atomic_compare_exchange_strong(a, old_val, new_val)
	return ok
}

// -----------------------------------------------------------------------------
// atomic_add (アトミック加算)
// -----------------------------------------------------------------------------
// アトミックに値を加算します。
//
// 動作:
//   現在の *a の値を取得し、b を加算した結果を *a に格納します。
//   この操作はアトミックに実行されます。
//
// パラメータ:
//   a - 操作対象のメモリ位置へのポインタ
//   b - 加算する値
//
// 戻り値:
//   加算前の古い値（*a の元の値）
//
// 使用例:
//   スレッドセーフなカウンターのインクリメントに使用します。
//
//   counter: int = 10
//   old := atomic_add(&counter, 5)
//   // old == 10, counter == 15
// -----------------------------------------------------------------------------
atomic_add :: proc "contextless" (a: ^$T, b: T) -> T {
	return intrinsics.atomic_add(a, b)
}

// -----------------------------------------------------------------------------
// atomic_sub (アトミック減算)
// -----------------------------------------------------------------------------
// アトミックに値を減算します。
//
// 動作:
//   現在の *a の値を取得し、b を減算した結果を *a に格納します。
//   この操作はアトミックに実行されます。
//
// パラメータ:
//   a - 操作対象のメモリ位置へのポインタ
//   b - 減算する値
//
// 戻り値:
//   減算前の古い値（*a の元の値）
//
// 使用例:
//   リソースの参照カウントを減らす際に使用します。
//
//   ref_count: int = 5
//   old := atomic_sub(&ref_count, 1)
//   // old == 5, ref_count == 4
// -----------------------------------------------------------------------------
atomic_sub :: proc "contextless" (a: ^$T, b: T) -> T {
	return intrinsics.atomic_sub(a, b)
}

// -----------------------------------------------------------------------------
// atomic_inc (アトミックインクリメント)
// -----------------------------------------------------------------------------
// アトミックに値を1増加させます。
//
// 動作:
//   *a の値を1増加させます。atomic_add(a, 1) と等価です。
//
// パラメータ:
//   a - 操作対象のメモリ位置へのポインタ（整数型のみ）
//
// 戻り値:
//   インクリメント前の古い値
//
// 制約:
//   T は整数型である必要があります（where節で強制）
//
// 使用例:
//   counter: int = 0
//   old := atomic_inc(&counter)
//   // old == 0, counter == 1
// -----------------------------------------------------------------------------
atomic_inc :: proc "contextless" (a: ^$T) -> T where intrinsics.type_is_integer(T) {
	return intrinsics.atomic_add(a, T(1))
}

// -----------------------------------------------------------------------------
// atomic_dec (アトミックデクリメント)
// -----------------------------------------------------------------------------
// アトミックに値を1減少させます。
//
// 動作:
//   *a の値を1減少させます。atomic_sub(a, 1) と等価です。
//
// パラメータ:
//   a - 操作対象のメモリ位置へのポインタ（整数型のみ）
//
// 戻り値:
//   デクリメント前の古い値
//
// 制約:
//   T は整数型である必要があります（where節で強制）
//
// 使用例:
//   参照カウントが0になったらリソースを解放するパターン:
//
//   ref_count: int = 1
//   if atomic_dec(&ref_count) == 1 {
//       // 古い値が1だったので、現在は0
//       // リソースを解放する
//   }
// -----------------------------------------------------------------------------
atomic_dec :: proc "contextless" (a: ^$T) -> T where intrinsics.type_is_integer(T) {
	return intrinsics.atomic_sub(a, T(1))
}

// -----------------------------------------------------------------------------
// atomic_or (アトミック論理OR)
// -----------------------------------------------------------------------------
// アトミックにビット単位のOR演算を行います。
//
// 動作:
//   *a = *a | b をアトミックに実行します。
//
// パラメータ:
//   a - 操作対象のメモリ位置へのポインタ
//   b - ORを取る値
//
// 戻り値:
//   OR演算前の古い値
//
// 使用例:
//   フラグをスレッドセーフに設定する際に使用します。
//
//   FLAG_READY :: 0x01
//   FLAG_DONE  :: 0x02
//   flags: u32 = 0
//   atomic_or(&flags, FLAG_READY)  // READY フラグを立てる
//   // flags == 0x01
// -----------------------------------------------------------------------------
atomic_or :: proc "contextless" (a: ^$T, b: T) -> T {
	return intrinsics.atomic_or(a, b)
}

// -----------------------------------------------------------------------------
// atomic_and (アトミック論理AND)
// -----------------------------------------------------------------------------
// アトミックにビット単位のAND演算を行います。
//
// 動作:
//   *a = *a & b をアトミックに実行します。
//
// パラメータ:
//   a - 操作対象のメモリ位置へのポインタ
//   b - ANDを取る値
//
// 戻り値:
//   AND演算前の古い値
//
// 使用例:
//   フラグをスレッドセーフにクリアする際に使用します。
//
//   FLAG_READY :: 0x01
//   flags: u32 = 0x03
//   atomic_and(&flags, ~u32(FLAG_READY))  // READY フラグをクリア
//   // flags == 0x02
// -----------------------------------------------------------------------------
atomic_and :: proc "contextless" (a: ^$T, b: T) -> T {
	return intrinsics.atomic_and(a, b)
}

// -----------------------------------------------------------------------------
// atomic_load (アトミックロード)
// -----------------------------------------------------------------------------
// アトミックに値を読み取ります。
//
// 動作:
//   *a の値をアトミックに読み取ります。
//   他のスレッドによる書き込みの途中（部分的に更新された状態）を
//   読み取ることがないことを保証します。
//
// パラメータ:
//   a - 読み取り対象のメモリ位置へのポインタ
//
// 戻り値:
//   *a の現在の値
//
// 使用例:
//   他のスレッドが更新する可能性のある共有変数を安全に読み取る:
//
//   shared_counter: int = 0  // 別スレッドが更新中かもしれない
//   current := atomic_load(&shared_counter)
// -----------------------------------------------------------------------------
atomic_load :: proc "contextless" (a: ^$T) -> T {
	return intrinsics.atomic_load(a)
}

// -----------------------------------------------------------------------------
// atomic_store (アトミックストア)
// -----------------------------------------------------------------------------
// アトミックに値を書き込みます。
//
// 動作:
//   *a に val をアトミックに書き込みます。
//   他のスレッドが読み取る際に、書き込みの途中（部分的に更新された状態）を
//   観測することがないことを保証します。
//
// パラメータ:
//   a   - 書き込み対象のメモリ位置へのポインタ
//   val - 書き込む値
//
// 使用例:
//   共有変数をスレッドセーフに更新する:
//
//   shared_flag: bool = false
//   atomic_store(&shared_flag, true)  // 他のスレッドに準備完了を通知
// -----------------------------------------------------------------------------
atomic_store :: proc "contextless" (a: ^$T, val: T) {
	intrinsics.atomic_store(a, val)
}
