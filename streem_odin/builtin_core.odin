package streem

import "core:fmt"
import "core:os"
import "core:strings"

// =============================================================================
// コアビルトイン関数モジュール (Core Built-in Functions Module)
// =============================================================================
//
// 参照元: src/exec.c
//
// このモジュールは、Streem言語の基本的なビルトイン関数を提供します。
// これらの関数は言語のコア機能として、I/O操作、比較演算、パイプ接続、
// ファイル操作、制御フロー、パターンマッチングなどを実装しています。
//
// ビルトイン関数のシグネチャ:
//   proc(strm: ^Strm_Stream, argc: int, args: []Strm_Value, ret: ^Strm_Value) -> int
//
// パラメータ:
//   strm - 現在のストリームコンテキスト（エラー報告やストリーム操作に使用）
//   argc - 引数の数
//   args - 引数の配列（Strm_Value型）
//   ret  - 戻り値を格納するポインタ
//
// 戻り値:
//   STRM_OK (0) - 成功
//   STRM_NG (1) - 失敗（引数エラーなど）
// =============================================================================

// =============================================================================
// I/O関数 (I/O Functions)
// =============================================================================

// -----------------------------------------------------------------------------
// exec_puts - 値を出力して改行する
// -----------------------------------------------------------------------------
// 任意の数の引数を受け取り、スペース区切りで標準出力に表示し、
// 最後に改行を出力します。
//
// Streem言語での使用例:
//   puts("Hello", "World")  # => Hello World
//   puts(123)               # => 123
//   puts()                  # => (空行)
//
// パラメータ:
//   argc - 出力する値の数（0以上の任意）
//   args - 出力する値の配列
//
// 動作:
//   1. 各引数を文字列に変換（strm_to_str）
//   2. 引数間にスペースを挿入して出力
//   3. 最後に改行を出力
//   4. nil を返す
// -----------------------------------------------------------------------------
exec_puts :: proc(strm: ^Strm_Stream, argc: int, args: []Strm_Value, ret: ^Strm_Value) -> int {
	for i in 0 ..< argc {
		if i > 0 {
			fmt.print(" ")
		}
		s := strm_to_str(args[i])
		fmt.print(s)
	}
	fmt.println()
	ret^ = strm_nil_value()
	return STRM_OK
}

// =============================================================================
// 比較演算子 (Comparison Operations)
// =============================================================================

// -----------------------------------------------------------------------------
// exec_eq - 等価比較演算子 (==)
// -----------------------------------------------------------------------------
// 2つの値が等しいかどうかを比較します。
//
// Streem言語での使用例:
//   1 == 1      # => true
//   "a" == "b"  # => false
//   nil == nil  # => true
//
// パラメータ:
//   argc - 必ず2（左辺と右辺）
//   args - [左辺の値, 右辺の値]
//
// 戻り値:
//   真偽値（true または false）
//
// 注意:
//   値の比較は strm_value_eq 関数で行われ、型と値の両方が一致する
//   必要があります。
// -----------------------------------------------------------------------------
exec_eq :: proc(strm: ^Strm_Stream, argc: int, args: []Strm_Value, ret: ^Strm_Value) -> int {
	if argc != 2 {
		return STRM_NG
	}

	ret^ = strm_bool_value(strm_value_eq(args[0], args[1]))
	return STRM_OK
}

// -----------------------------------------------------------------------------
// exec_neq - 非等価比較演算子 (!=)
// -----------------------------------------------------------------------------
// 2つの値が等しくないかどうかを比較します。
//
// Streem言語での使用例:
//   1 != 2      # => true
//   "a" != "a"  # => false
//
// パラメータ:
//   argc - 必ず2（左辺と右辺）
//   args - [左辺の値, 右辺の値]
//
// 戻り値:
//   真偽値（true または false）
// -----------------------------------------------------------------------------
exec_neq :: proc(strm: ^Strm_Stream, argc: int, args: []Strm_Value, ret: ^Strm_Value) -> int {
	if argc != 2 {
		return STRM_NG
	}

	ret^ = strm_bool_value(!strm_value_eq(args[0], args[1]))
	return STRM_OK
}

// =============================================================================
// パイプ演算子 (Pipe Operator)
// =============================================================================

// -----------------------------------------------------------------------------
// exec_bar - パイプ/ビット論理和演算子 (|)
// -----------------------------------------------------------------------------
// コンテキストに応じて2つの動作を行います:
//
// 1. 整数同士の場合: ビット単位のOR演算
//    5 | 3  # => 7 (0101 | 0011 = 0111)
//
// 2. それ以外の場合: ストリームの接続
//    stdin | filter | stdout
//
// Streem言語での使用例:
//   # ストリーム接続
//   seq(10) | map{|x| x * 2} | stdout
//
//   # ビット演算
//   flags = 0x01 | 0x04  # => 0x05
//
// パラメータ:
//   argc - 必ず2（左辺と右辺）
//   args - [左辺の値, 右辺の値]
//
// 動作:
//   1. 両方が整数なら、ビットORを計算して返す
//   2. それ以外なら、strm_connect でストリームを接続
// -----------------------------------------------------------------------------
exec_bar :: proc(strm: ^Strm_Stream, argc: int, args: []Strm_Value, ret: ^Strm_Value) -> int {
	if argc != 2 {
		return STRM_NG
	}

	// 整数同士の場合はビット論理和
	if strm_int_p(args[0]) && strm_int_p(args[1]) {
		ret^ = strm_int_value(strm_value_int(args[0]) | strm_value_int(args[1]))
		return STRM_OK
	}

	// それ以外はストリーム接続
	return strm_connect(strm, args[0], args[1], ret)
}

// =============================================================================
// ファイル操作 (File Operations)
// =============================================================================

// -----------------------------------------------------------------------------
// exec_fread - ファイル読み込みストリームを開く
// -----------------------------------------------------------------------------
// 指定されたパスのファイルを読み込み用に開き、
// 行単位で読み込むプロデューサーストリームを返します。
//
// Streem言語での使用例:
//   fread("data.txt") | map{|line| process(line)} | stdout
//
// パラメータ:
//   argc - 必ず1
//   args - [ファイルパス文字列]
//
// 戻り値:
//   読み込み用ストリーム（Strm_Stream）
//
// エラー:
//   引数が1つでない場合、または引数が文字列でない場合は STRM_NG
// -----------------------------------------------------------------------------
exec_fread :: proc(strm: ^Strm_Stream, argc: int, args: []Strm_Value, ret: ^Strm_Value) -> int {
	if argc != 1 || !strm_string_p(args[0]) {
		return STRM_NG
	}

	str := Strm_String(args[0])
	path := strm_str_ptr(&str)
	ret^ = strm_fread(path)
	return STRM_OK
}

// -----------------------------------------------------------------------------
// exec_fwrite - ファイル書き込みストリームを開く
// -----------------------------------------------------------------------------
// 指定されたパスのファイルを書き込み用に開き、
// データを書き込むコンシューマーストリームを返します。
//
// Streem言語での使用例:
//   seq(10) | map{|x| x.to_s} | fwrite("output.txt")
//
// パラメータ:
//   argc - 必ず1
//   args - [ファイルパス文字列]
//
// 戻り値:
//   書き込み用ストリーム（Strm_Stream）
//
// エラー:
//   引数が1つでない場合、または引数が文字列でない場合は STRM_NG
// -----------------------------------------------------------------------------
exec_fwrite :: proc(strm: ^Strm_Stream, argc: int, args: []Strm_Value, ret: ^Strm_Value) -> int {
	if argc != 1 || !strm_string_p(args[0]) {
		return STRM_NG
	}

	str := Strm_String(args[0])
	path := strm_str_ptr(&str)
	ret^ = strm_fwrite(path)
	return STRM_OK
}

// =============================================================================
// 制御フロー (Control Flow)
// =============================================================================

// -----------------------------------------------------------------------------
// exec_exit - プログラムを終了する
// -----------------------------------------------------------------------------
// 指定された終了コードでプログラムを即座に終了します。
//
// Streem言語での使用例:
//   exit()     # 終了コード 0 で終了
//   exit(1)    # 終了コード 1 で終了（エラー）
//   exit(0)    # 終了コード 0 で終了（成功）
//
// パラメータ:
//   argc - 0 または 1
//   args - [終了コード（整数、省略時は0）]
//
// 注意:
//   この関数は os.exit を呼び出すため、戻りません。
// -----------------------------------------------------------------------------
exec_exit :: proc(strm: ^Strm_Stream, argc: int, args: []Strm_Value, ret: ^Strm_Value) -> int {
	code := 0
	if argc > 0 && strm_int_p(args[0]) {
		code = int(strm_value_int(args[0]))
	}
	os.exit(code)
}

// =============================================================================
// パターンマッチング (Pattern Matching)
// =============================================================================

// -----------------------------------------------------------------------------
// exec_match - パターンマッチングヘルパー
// -----------------------------------------------------------------------------
// 値とパターン関数を受け取り、パターン関数に値を渡して実行します。
//
// Streem言語での使用例:
//   match(value, {|x|
//     case x of
//       1 -> "one"
//       2 -> "two"
//       _ -> "other"
//   })
//
// パラメータ:
//   argc - 2以上
//   args - [マッチ対象の値, パターン関数, ...]
//
// 動作:
//   パターン関数（args[1]）に対象値（args[0]）を引数として渡して呼び出し、
//   その結果を返します。
// -----------------------------------------------------------------------------
exec_match :: proc(strm: ^Strm_Stream, argc: int, args: []Strm_Value, ret: ^Strm_Value) -> int {
	if argc < 2 {
		return STRM_NG
	}

	val := args[0]
	func_ := args[1]

	// パターン関数に値を渡して呼び出す
	return int(strm_funcall(strm, nil, func_, []Strm_Value{val}, ret))
}

// =============================================================================
// 初期化 (Initialization)
// =============================================================================

// -----------------------------------------------------------------------------
// strm_misc_init - コアビルトイン関数の初期化
// -----------------------------------------------------------------------------
// Streem言語のグローバルスコープに、コアビルトイン関数と
// 標準I/Oオブジェクトを登録します。
//
// 登録されるオブジェクト:
//
// 【I/Oオブジェクト】
//   stdin  - 標準入力ストリーム（行単位で読み込むプロデューサー）
//   stdout - 標準出力ストリーム（データを書き込むコンシューマー）
//   stderr - 標準エラー出力ストリーム
//
// 【出力関数】
//   puts   - 値を出力して改行
//   print  - puts のエイリアス
//
// 【比較演算子】
//   ==     - 等価比較
//   !=     - 非等価比較
//
// 【パイプ演算子】
//   |      - ストリーム接続またはビット論理和
//
// 【ファイル操作】
//   fread  - ファイル読み込みストリームを開く
//   fwrite - ファイル書き込みストリームを開く
//
// 【制御フロー】
//   exit   - プログラムを終了
//
// 【パターンマッチング】
//   match  - パターンマッチングヘルパー
// -----------------------------------------------------------------------------
strm_misc_init :: proc(state: ^Strm_State) {
	// I/Oオブジェクト
	strm_var_def(state, strm_str_intern("stdin"), strm_io_new(os.stdin, STRM_IO_READ))
	strm_var_def(state, strm_str_intern("stdout"), strm_io_new(os.stdout, STRM_IO_WRITE))
	strm_var_def(state, strm_str_intern("stderr"), strm_io_new(os.stderr, STRM_IO_WRITE))

	// 出力関数
	strm_var_def(state, strm_str_intern("puts"), strm_cfunc_value(exec_puts))
	strm_var_def(state, strm_str_intern("print"), strm_cfunc_value(exec_puts))

	// 比較演算子
	strm_var_def(state, strm_str_intern("=="), strm_cfunc_value(exec_eq))
	strm_var_def(state, strm_str_intern("!="), strm_cfunc_value(exec_neq))

	// パイプ演算子
	strm_var_def(state, strm_str_intern("|"), strm_cfunc_value(exec_bar))

	// ファイル操作
	strm_var_def(state, strm_str_intern("fread"), strm_cfunc_value(exec_fread))
	strm_var_def(state, strm_str_intern("fwrite"), strm_cfunc_value(exec_fwrite))

	// 制御フロー
	strm_var_def(state, strm_str_intern("exit"), strm_cfunc_value(exec_exit))

	// パターンマッチング
	strm_var_def(state, strm_str_intern("match"), strm_cfunc_value(exec_match))
}
