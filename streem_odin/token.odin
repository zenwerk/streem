// ============================================================================
// token.odin - Streem言語のトークン定義
// ============================================================================
//
// 概要:
//   このファイルはStreem言語の字句解析（レキサー）で使用される
//   トークンの型と関連する構造体・関数を定義します。
//
// トークンとは:
//   ソースコードを構成する最小単位の要素。
//   レキサーがソースコードを読み取り、トークンの列に分解します。
//   例: "x = 1 + 2" → [Ident("x"), Op_Assign, Lit_Int(1), Op_Plus, Lit_Int(2)]
//
// トークンの分類:
//   1. 特殊トークン: EOF, Error, Newline
//   2. リテラル: 整数, 浮動小数点, 文字列, シンボル, 時刻
//   3. 識別子: 変数名, ラベル
//   4. キーワード: if, else, def, class など
//   5. 演算子: 算術, 比較, 論理, ビット演算, 代入, ラムダ
//   6. 区切り記号: 括弧, カンマ, セミコロンなど
//
// 参照: src/lex.l
// ============================================================================

package streem

// ============================================================================
// トークン型の定義
// ============================================================================

// ----------------------------------------------------------------------------
// Token_Type - トークンの種類を表す列挙型
// ----------------------------------------------------------------------------
// 説明:
//   Streem言語で使用される全てのトークンの種類を定義します。
//   レキサーが生成し、パーサーが消費します。
//
// カテゴリ:
//   - 特殊トークン: ファイル終端、エラー、改行
//   - リテラル: 値を直接表す（数値、文字列など）
//   - 識別子: 変数名やラベル
//   - キーワード: 言語の予約語
//   - 演算子: 計算や比較を行う
//   - 区切り記号: 構文を区切る
// ----------------------------------------------------------------------------
Token_Type :: enum {
	// ========================================================================
	// 特殊トークン
	// ========================================================================
	// ファイルの終端や特殊な状態を表すトークン

	Eof,     // ファイル終端（End of File）
	Error,   // 字句解析エラー（不正な文字など）
	Newline, // 改行（文の終端として重要）

	// ========================================================================
	// リテラル（値を直接表すトークン）
	// ========================================================================

	Lit_Int,    // 整数リテラル（10進数, 16進数 0x, 8進数 0o）
	            // 例: 42, 0xFF, 0o755
	Lit_Float,  // 浮動小数点リテラル
	            // 例: 3.14, 1.0e-5
	Lit_String, // 文字列リテラル（ダブルクォート、エスケープシーケンス対応）
	            // 例: "hello", "line1\nline2"
	Lit_Symbol, // シンボルリテラル（コロン + 識別子）
	            // 例: :name, :status
	Lit_Time,   // 時刻リテラル（日付または日時）
	            // 例: 2024.01.15, 2024.01.15T10:30:00

	// ========================================================================
	// 識別子とラベル
	// ========================================================================

	Ident, // 識別子（変数名、関数名など）
	       // Unicode対応、先頭は文字またはアンダースコア
	       // 例: foo, _bar, 日本語変数
	Label, // ラベル（識別子 + コロン、名前付き引数用）
	       // 例: name:, timeout:

	// ========================================================================
	// キーワード（予約語）
	// ========================================================================
	// 言語構文で特別な意味を持つ単語
	// これらは識別子として使用できない

	Kw_If,        // if - 条件分岐
	Kw_Else,      // else - 条件分岐の代替
	Kw_Case,      // case - パターンマッチング
	Kw_Emit,      // emit - ストリームへの値の出力
	Kw_Skip,      // skip - 現在の反復をスキップ
	Kw_Return,    // return - 関数からの戻り
	Kw_Namespace, // namespace - 名前空間の定義
	Kw_Class,     // class - クラスの定義
	Kw_Import,    // import - モジュールのインポート
	Kw_Def,       // def - 関数の定義
	Kw_Method,    // method - メソッドの定義
	Kw_New,       // new - インスタンスの生成
	Kw_Nil,       // nil - null値
	Kw_True,      // true - 真偽値（真）
	Kw_False,     // false - 真偽値（偽）

	// ========================================================================
	// 算術演算子
	// ========================================================================

	Op_Plus,  // + 加算
	Op_Minus, // - 減算（単項マイナスとしても使用）
	Op_Mult,  // * 乗算
	Op_Div,   // / 除算
	Op_Mod,   // % 剰余（モジュロ）

	// ========================================================================
	// 比較演算子
	// ========================================================================

	Op_Eq,  // == 等価
	Op_Neq, // != 非等価
	Op_Lt,  // <  小なり
	Op_Le,  // <= 以下
	Op_Gt,  // >  大なり
	Op_Ge,  // >= 以上

	// ========================================================================
	// 論理演算子
	// ========================================================================

	Op_And, // && 論理積（短絡評価）
	Op_Or,  // || 論理和（短絡評価）
	Op_Not, // !  論理否定

	// ========================================================================
	// ビット演算子
	// ========================================================================

	Op_Amper, // & ビット積（AND）
	Op_Bar,   // | ビット和（OR）、パイプ演算子としても使用
	Op_Tilde, // ~ ビット否定（NOT）

	// ========================================================================
	// 代入演算子とアロー演算子
	// ========================================================================

	Op_Assign, // =  代入
	Op_Lasgn,  // <- 左代入（ストリームからの受信）
	Op_Rasgn,  // => 右代入（パターンマッチ、ストリームへの送信）

	// ========================================================================
	// ラムダ演算子
	// ========================================================================
	// 無名関数（ラムダ式）の定義に使用

	Op_Lambda,  // -> ラムダ矢印
	            // 例: x -> x * 2
	Op_Lambda2, // )-> 特殊形式：括弧閉じ + 矢印
	            // 例: (x, y)-> x + y
	Op_Lambda3, // )->{ 特殊形式：括弧閉じ + 矢印 + ブレース開き
	            // 例: (x)->{
	            //       emit x * 2
	            //     }

	// ========================================================================
	// スコープ演算子
	// ========================================================================

	Op_Colon2, // :: スコープ解決演算子
	           // 例: Math::PI, Module::function

	// ========================================================================
	// 区切り記号（デリミタ）
	// ========================================================================

	Left_Paren,    // ( 左括弧（関数呼び出し、グループ化）
	Right_Paren,   // ) 右括弧
	Left_Bracket,  // [ 左角括弧（配列リテラル、インデックス）
	Right_Bracket, // ] 右角括弧
	Left_Brace,    // { 左波括弧（ブロック開始）
	Right_Brace,   // } 右波括弧（ブロック終了）
	Comma,         // , カンマ（要素の区切り）
	Semicolon,     // ; セミコロン（文の区切り）
	Colon,         // : コロン（型注釈、シンボル）
	Dot,           // . ドット（メンバーアクセス）
	At,            // @ アット（名前空間参照、デコレータ）
}

// ============================================================================
// 位置情報
// ============================================================================

// ----------------------------------------------------------------------------
// Pos - ソースコード内の位置情報
// ----------------------------------------------------------------------------
// 説明:
//   トークンやエラーがソースコード内のどこに位置するかを表します。
//   エラーメッセージの生成や、デバッグ情報に使用されます。
//
// フィールド:
//   offset - ソースコード先頭からのバイトオフセット（0起点）
//   line   - 行番号（1起点）
//   column - 列番号（1起点、バイト単位）
//
// 使用例:
//   エラーメッセージ: "example.strm:10:5: unexpected token"
//                     ファイル名:行:列: メッセージ
// ----------------------------------------------------------------------------
Pos :: struct {
	offset: int, // ソースコード先頭からのバイトオフセット
	line:   int, // 行番号（1起点）
	column: int, // 列番号（1起点）
}

// ============================================================================
// トークン構造体
// ============================================================================

// ----------------------------------------------------------------------------
// Token - トークンの完全な情報
// ----------------------------------------------------------------------------
// 説明:
//   レキサーが生成する個々のトークンを表す構造体。
//   位置情報、トークンの種類、元のテキストを保持します。
//
// フィールド:
//   pos      - ソースコード内の位置（Pos構造体を埋め込み）
//   type     - トークンの種類（Token_Type）
//   lexeme   - トークンの元のテキスト（ソースコードから切り出した文字列）
//   consumed - パーサーが消費済みかどうかのフラグ
//
// usingキーワード:
//   `using pos: Pos` により、Token.line のように Pos のフィールドに
//   直接アクセスできます（Token.pos.line と書く必要がない）
//
// 使用例:
//   token := Token{
//       pos = Pos{offset = 0, line = 1, column = 1},
//       type = .Ident,
//       lexeme = "foo",
//       consumed = false,
//   }
//   // token.line で行番号にアクセス可能
// ----------------------------------------------------------------------------
Token :: struct {
	using pos: Pos,        // 位置情報（埋め込み）
	type:      Token_Type, // トークンの種類
	lexeme:    string,     // トークンの元テキスト
	consumed:  bool,       // パーサーによる消費フラグ
}

// ============================================================================
// トークン判定関数
// ============================================================================

// ----------------------------------------------------------------------------
// token_is_keyword - キーワード判定
// ----------------------------------------------------------------------------
// 説明:
//   トークンがキーワード（予約語）かどうかを判定します。
//
// 引数:
//   t - 判定するトークンの種類
//
// 戻り値:
//   true  - キーワードである
//   false - キーワードでない
//
// 対象:
//   if, else, case, emit, skip, return, namespace, class,
//   import, def, method, new, nil, true, false
//
// 使用例:
//   if token_is_keyword(token.type) {
//       // キーワードとして処理
//   }
// ----------------------------------------------------------------------------
token_is_keyword :: proc(t: Token_Type) -> bool {
	#partial switch t {
	case .Kw_If, .Kw_Else, .Kw_Case, .Kw_Emit, .Kw_Skip, .Kw_Return,
	     .Kw_Namespace, .Kw_Class, .Kw_Import, .Kw_Def, .Kw_Method, .Kw_New,
	     .Kw_Nil, .Kw_True, .Kw_False:
		return true
	}
	return false
}

// ----------------------------------------------------------------------------
// token_is_binary_op - 二項演算子判定
// ----------------------------------------------------------------------------
// 説明:
//   トークンが二項演算子（2つのオペランドを取る演算子）かどうかを判定します。
//
// 引数:
//   t - 判定するトークンの種類
//
// 戻り値:
//   true  - 二項演算子である
//   false - 二項演算子でない
//
// 対象:
//   算術: +, -, *, /, %
//   比較: ==, !=, <, <=, >, >=
//   論理: &&, ||
//   ビット: &, |
//
// 使用例:
//   if token_is_binary_op(token.type) {
//       // 二項演算式としてパース
//   }
// ----------------------------------------------------------------------------
token_is_binary_op :: proc(t: Token_Type) -> bool {
	#partial switch t {
	case .Op_Plus, .Op_Minus, .Op_Mult, .Op_Div, .Op_Mod,
	     .Op_Eq, .Op_Neq, .Op_Lt, .Op_Le, .Op_Gt, .Op_Ge,
	     .Op_And, .Op_Or, .Op_Amper, .Op_Bar:
		return true
	}
	return false
}

// ----------------------------------------------------------------------------
// token_is_unary_op - 単項演算子判定
// ----------------------------------------------------------------------------
// 説明:
//   トークンが単項演算子（1つのオペランドを取る演算子）かどうかを判定します。
//
// 引数:
//   t - 判定するトークンの種類
//
// 戻り値:
//   true  - 単項演算子である
//   false - 単項演算子でない
//
// 対象:
//   - (マイナス: 符号反転)
//   ! (論理否定)
//   ~ (ビット否定)
//
// 注意:
//   Op_Minus は二項演算子としても単項演算子としても使用される
//
// 使用例:
//   if token_is_unary_op(token.type) {
//       // 単項演算式としてパース
//   }
// ----------------------------------------------------------------------------
token_is_unary_op :: proc(t: Token_Type) -> bool {
	#partial switch t {
	case .Op_Minus, .Op_Not, .Op_Tilde:
		return true
	}
	return false
}

// ----------------------------------------------------------------------------
// token_is_literal - リテラル判定
// ----------------------------------------------------------------------------
// 説明:
//   トークンがリテラル（値を直接表すトークン）かどうかを判定します。
//
// 引数:
//   t - 判定するトークンの種類
//
// 戻り値:
//   true  - リテラルである
//   false - リテラルでない
//
// 対象:
//   - 整数リテラル (Lit_Int)
//   - 浮動小数点リテラル (Lit_Float)
//   - 文字列リテラル (Lit_String)
//   - シンボルリテラル (Lit_Symbol)
//   - 時刻リテラル (Lit_Time)
//   - nil, true, false（キーワードだがリテラル値として扱う）
//
// 使用例:
//   if token_is_literal(token.type) {
//       // リテラルノードを生成
//   }
// ----------------------------------------------------------------------------
token_is_literal :: proc(t: Token_Type) -> bool {
	#partial switch t {
	case .Lit_Int, .Lit_Float, .Lit_String, .Lit_Symbol, .Lit_Time,
	     .Kw_Nil, .Kw_True, .Kw_False:
		return true
	}
	return false
}

// ============================================================================
// トークン文字列変換
// ============================================================================

// ----------------------------------------------------------------------------
// token_type_string - トークン型を文字列に変換
// ----------------------------------------------------------------------------
// 説明:
//   トークンの種類をデバッグ用の文字列表現に変換します。
//   エラーメッセージやログ出力に使用されます。
//
// 引数:
//   t - 変換するトークンの種類
//
// 戻り値:
//   トークン型の文字列表現
//
// 使用例:
//   fmt.printf("Unexpected token: %s\n", token_type_string(token.type))
//   // 出力例: "Unexpected token: IDENT"
// ----------------------------------------------------------------------------
token_type_string :: proc(t: Token_Type) -> string {
	return token_type_strings[t]
}

// ----------------------------------------------------------------------------
// token_type_strings - トークン型から文字列へのマッピング
// ----------------------------------------------------------------------------
// 説明:
//   各トークン型に対応する文字列を定義した配列。
//   token_type_string関数から参照されます。
//
// 形式:
//   - 特殊トークン: 大文字（EOF, ERROR, NEWLINE）
//   - リテラル: 型名（INT, FLOAT, STRING, SYMBOL, TIME）
//   - 識別子: 大文字（IDENT, LABEL）
//   - キーワード: そのまま（if, else, def など）
//   - 演算子/区切り: 記号そのまま（+, -, ==, ( など）
// ----------------------------------------------------------------------------
@(private = "file")
token_type_strings := [Token_Type]string {
	// 特殊トークン
	.Eof           = "EOF",     // ファイル終端
	.Error         = "ERROR",   // エラー
	.Newline       = "NEWLINE", // 改行

	// リテラル
	.Lit_Int       = "INT",     // 整数
	.Lit_Float     = "FLOAT",   // 浮動小数点
	.Lit_String    = "STRING",  // 文字列
	.Lit_Symbol    = "SYMBOL",  // シンボル
	.Lit_Time      = "TIME",    // 時刻

	// 識別子
	.Ident         = "IDENT",   // 識別子
	.Label         = "LABEL",   // ラベル

	// キーワード
	.Kw_If         = "if",
	.Kw_Else       = "else",
	.Kw_Case       = "case",
	.Kw_Emit       = "emit",
	.Kw_Skip       = "skip",
	.Kw_Return     = "return",
	.Kw_Namespace  = "namespace",
	.Kw_Class      = "class",
	.Kw_Import     = "import",
	.Kw_Def        = "def",
	.Kw_Method     = "method",
	.Kw_New        = "new",
	.Kw_Nil        = "nil",
	.Kw_True       = "true",
	.Kw_False      = "false",

	// 算術演算子
	.Op_Plus       = "+",
	.Op_Minus      = "-",
	.Op_Mult       = "*",
	.Op_Div        = "/",
	.Op_Mod        = "%",

	// 比較演算子
	.Op_Eq         = "==",
	.Op_Neq        = "!=",
	.Op_Lt         = "<",
	.Op_Le         = "<=",
	.Op_Gt         = ">",
	.Op_Ge         = ">=",

	// 論理演算子
	.Op_And        = "&&",
	.Op_Or         = "||",
	.Op_Not        = "!",

	// ビット演算子
	.Op_Amper      = "&",
	.Op_Bar        = "|",
	.Op_Tilde      = "~",

	// 代入演算子
	.Op_Assign     = "=",
	.Op_Lasgn      = "<-",
	.Op_Rasgn      = "=>",

	// ラムダ演算子
	.Op_Lambda     = "->",
	.Op_Lambda2    = ")->",
	.Op_Lambda3    = ")->{",

	// スコープ演算子
	.Op_Colon2     = "::",

	// 区切り記号
	.Left_Paren    = "(",
	.Right_Paren   = ")",
	.Left_Bracket  = "[",
	.Right_Bracket = "]",
	.Left_Brace    = "{",
	.Right_Brace   = "}",
	.Comma         = ",",
	.Semicolon     = ";",
	.Colon         = ":",
	.Dot           = ".",
	.At            = "@",
}
